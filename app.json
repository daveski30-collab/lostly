{
  "expo": {
    "name": "Lostly",
    "slug": "lostly",
    "scheme": "lostly",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lostly.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.lostly.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFD84D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Lostly",
      "shortName": "Lostly",
      "themeColor": "#15122E",
      "backgroundColor": "#15122E",
      "description": "Never leave your stuff behind."
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Lostly checks when you leave your saved places so it can remind you to grab your stuff. It never shares your location.",
          "locationWhenInUsePermission": "Lostly uses your location to save places like home, school, or the gym.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#15122E"
        }
      ]
    ],
    "backgroundColor": "#15122E"
  }
}